{
  "name": "atlas",
  "version": "1.0.0",
  "description": "API Atlas - Express + PostgreSQL (intencionalmente vulnerable)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "audit:gate": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "src/app.js",
      "src/routes/auth.js",
      "src/routes/roles.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 80,
        "branches": 70
      }
    }
  }
}
